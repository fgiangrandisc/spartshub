# Plantilla de variables de entorno de PortalMaquinas.
# Copiar a .env y completar con los valores reales.
# El archivo .env NO se sube a Git (esta en .gitignore).
#
# Los valores reales se obtienen desde el dashboard de Supabase
# (Project Settings -> API) o con: vercel env pull .env

VITE_SUPABASE_URL=
VITE_SUPABASE_KEY=

# OJO: las variables VITE_* quedan incrustadas en el JavaScript publico
# del sitio. NO poner aca una API key real de Anthropic: seria visible
# para cualquiera que abra las devtools. Dejar en blanco.
VITE_ANTHROPIC_KEY=
